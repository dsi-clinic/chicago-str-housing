# Copy to `.env` and adjust paths. The Makefile uses `-include .env` when present.

# Folder with tract shapefile, ZORI CSV, etc. (see README). In Docker this is /project/data.
DATA_DIR=/Users/username/path_to_data_dir/

# U.S. Census Bureau API key for ACS pulls (see https://api.census.gov/data/key_signup.html).
# If unset, the pipeline may fall back to a bundled demo key with a log warning.
CENSUS_API_KEY=

# Callaway–Sant'Anna pipeline: `threshold` (default), `binary`, or `both` (two full runs under
# `{DID_CS_OUTPUT_DIR}-threshold` and `{DID_CS_OUTPUT_DIR}-binary`).
# DID_TREATMENT_MODE=threshold

# Optional override for CS outputs (defaults: output/did-cs or output/did-cs-whitepaper).
# DID_CS_OUTPUT_DIR=

# Optional: extra diagnostics + LaTeX tables for the white paper (see docs/DID_CS_RUNBOOK.md).
# DID_WHITEPAPER_MODE=1
